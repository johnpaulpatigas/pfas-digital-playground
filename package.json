{
  "name": "pfas-digital-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "lint": "oxlint && biome check",
    "lint:fix": "oxlint --fix && biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@tailwindcss/vite": "^4.3.5",
    "katex": "^0.19.1",
    "lucide-react": "^1.74.0",
    "mathjs": "^15.2.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@capacitor/cli": "^8.6.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
